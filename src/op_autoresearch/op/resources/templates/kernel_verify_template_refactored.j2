            Timeout_msg= "Dynamic Shape Case + st(case_idx + 1) + + st({{ timeout }}) + sec"
            Access_msg= "Dynamic Shape Case + sp(case_idx + 1) + "Certification Success",
        )
        case_result["idx"] = case_idx
        case_result["case_desc"] = _case_desc(inputs_for_framework)
