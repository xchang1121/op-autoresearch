# Timeout Decorator Function
def timeout_handler(signum, frame):
    raise TimeoutError("operation timed out")

def with_timeout(timeout_seconds):
    ""The Decorator: Add timeout control to the function."
    def decorator(func):
        @functools.wraps(func)
        def wrapper(*args, **kwargs):
            # Windows does not support SIGALRM, using threads or other means.
            if hasattr(signal, 'SIGALRM'):
                # Set signal processor
                old_handler = signal.signal(signal.SIGALRM, timeout_handler)
                signal.alarm(timeout_seconds)
                try:
                    result = func(*args, **kwargs)
                    return result
                finally:
                    # Restore original signal processor
                    signal.alarm(0)
                    signal.signal(signal.SIGALRM, old_handler)
            else:
                # If SIGALRM is not supported, run directly (dependent on external process level timeout)
                return func(*args, **kwargs)
        return wrapper
    return decorator

