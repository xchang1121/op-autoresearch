{
  "skill": "ascendc-crash-debug",
  "version": "2.0",
  "Description": "AscendC memory detection configuration file template - Copy this file as memcheck_input.json and fill out parameters",

  "operator": {
    "name": "sparse_flash_attention_enhance",
    "Description": "operator name"
  },

  "paths": {
    "code_base_dir": "training/ascendc/src",
    "Description": "Code Repository Directory (which must contain build.sh)"
  },

  "testing": {
    "test_script_dir": "training/ascendc/src/ops-transformer/attention/sparse_flash_attention_enhance/tests/st",
    "test_script_exe": "pytest test_npu_sparse_flash_attention_enhance.py",
    "Description": "ST test script absolute path"
  },

  "environment": {
    "device_type": "ascend910b",
    "cann_env": "/latest",
    "Description": "NPU device Type and CANN Environment Path"
  },

  "compilation": {
    "sanitizer_options": "-sanitizer;-g",
    "Description": "Compile Options. -g Get Full Debug Information"
  },

  "memcheck": {
    "log_level": "3",
    "slog_print_to_stdout": "true",
    "timeout": 600,
    "Description": "Memcheck Run Configuration"
  },

  "options": {
    "rebuild": true,
    "description": "Enforce options control. rebuild=false equals --skip-build command line options"
  }
}